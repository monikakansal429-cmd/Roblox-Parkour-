* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  overflow: hidden;
  font-family: Arial, sans-serif;
  background: #050816;
  color: white;
}

.hidden {
  display: none !important;
}

/* MENU */

.screen {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 18px;
  text-align: center;
  background:
    radial-gradient(circle at center, #16245c, #050816 70%);
}

.screen h1 {
  font-size: clamp(35px, 7vw, 80px);
  letter-spacing: 4px;
  text-shadow:
    0 0 10px #00eaff,
    0 0 30px #0077ff;
}

.screen p {
  font-size: 18px;
  color: #bdefff;
}

button {
  width: 250px;
  padding: 15px 20px;
  border: 2px solid #00eaff;
  border-radius: 12px;
  background: rgba(0, 234, 255, 0.08);
  color: white;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.2s;
  box-shadow: 0 0 15px rgba(0, 234, 255, 0.3);
}

button:hover {
  transform: scale(1.06);
  background: #00bcd4;
  color: #001018;
  box-shadow: 0 0 30px #00eaff;
}

button:active {
  transform: scale(0.95);
}

/* GAME */

#game {
  position: fixed;
  inset: 0;
}

#gameCanvas {
  width: 100%;
  height: 100%;
  display: block;
}

#hud {
  position: fixed;
  top: 15px;
  left: 15px;
  right: 15px;
  z-index: 5;

  display: flex;
  justify-content: space-between;
  gap: 10px;

  padding: 12px 18px;

  border: 1px solid #00eaff;
  border-radius: 12px;

  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8px);

  font-size: 16px;
  box-shadow: 0 0 15px rgba(0, 234, 255, 0.25);
}

/* MOBILE */

#mobileControls {
  position: fixed;
  bottom: 20px;
  left: 15px;
  right: 15px;
  z-index: 8;

  display: flex;
  justify-content: space-between;
  align-items: center;

  pointer-events: none;
}

#mobileControls button {
  pointer-events: auto;

  width: 65px;
  height: 65px;
  padding: 0;

  border-radius: 50%;

  background: rgba(0, 0, 0, 0.55);
  font-size: 25px;
}

#sprintBtn {
  border-color: #ffcc00;
}

/* SMALL SCREENS */

@media (max-width: 600px) {

  #hud {
    font-size: 12px;
    padding: 8px;
  }

  .screen h1 {
    font-size: 35px;
  }

  .screen button {
    width: 210px;
  }

  #mobileControls button {
    width: 55px;
    height: 55px;
  }
}
